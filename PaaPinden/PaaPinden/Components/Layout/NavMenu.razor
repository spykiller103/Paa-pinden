@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

@implements IDisposable
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject IUserRepo UserRepo
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="navbar-container">
    <div class="container-fluid">
        <span class="d-flex align-items-center gap-2">
            <p class="brand-mark">P</p>
            <a class="navbar-brand text-white" href="">PaaPinden</a>
        </span>
    </div>


    <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

    <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
        <nav class="nav flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill custom-icon-transformer" aria-hidden="true"></span> Hjem
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="@FollowersOrFollowingActive" href="followers">
                    <span class="bi bi-people custom-icon-transformer" aria-hidden="true"></span> Følgere
                </NavLink>
            </div>
    
            <AuthorizeView>
                <Authorized>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="createPost">
                            <span class="bi bi-plus-lg custom-icon-transformer" aria-hidden="true"></span> Opret opslag
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="projects">
                            <span class="bi bi-collection custom-icon-transformer" aria-hidden="true"></span> Projekter
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="savedposts">
                            <span class="bi bi-bookmarks custom-icon-transformer" aria-hidden="true"></span> Gemte opslag
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                            <button type="submit" class="nav-link">
                                <span class="bi bi-arrow-bar-left custom-icon-transformer" aria-hidden="true"></span> Log ud
                            </button>
                        </form>
                    </div>

                    <div class="nav-item navbar-user">
                        <NavLink class="nav-link" href="Account/Manage">
                            <img class="profile-picture" src="@currentUser?.ProfilePicture" aria-hidden="true" />

                            <div class="user-info">
                                <p class="text-white">@currentUser?.FullName</p>
                                <p class="username">@@@currentUser?.UserName</p>
                            </div>
                        </NavLink>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="Account/Register">
                            <span class="bi bi-person custom-icon-transformer" aria-hidden="true"></span> Register
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="Account/Login">
                            <span class="bi bi-person-badge custom-icon-transformer" aria-hidden="true"></span> Login
                        </NavLink>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>
</div>

@code {
    private ApplicationUser? currentUser;
    private string? currentUrl;
    
    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = UserManager.GetUserId(authState.User);

        if (userId != null)
        {
            currentUser = await UserRepo.GetUserByIdAsync(userId);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private string FollowersOrFollowingActive =>
        NavigationManager.Uri.ToLower().Contains("/followers") || NavigationManager.Uri.ToLower().Contains("/following") ? "nav-link active" : "nav-link";
}