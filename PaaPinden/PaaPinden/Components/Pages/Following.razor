@page "/following"
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="feed-tabs">
    <button class="tab-btn" @onclick='() => Navigation.NavigateTo("/followers")'>Followers</button>
    <button class="tab-btn active">Following</button>
</div>

<br />

<h1 class="heading-h1">Personer du følger</h1>
<p>Hold styr på de kreative profiler, du har valgt at følge</p>

<!-- SearchBar -->
<div class="search-container">
    <i class="bi bi-search"></i>

    <input class="search-bar form-control"
           type="search"
           placeholder="Søg efter en person"
           aria-label="Search" />

    <div class="search-results"></div>
</div>

