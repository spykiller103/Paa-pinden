@page "/CreatePind"
@attribute [Authorize]
@inject IPindService PindService
@inject NavigationManager navigationManager
<h3>Pind</h3>

<EditForm Model="pindDTO" enctype="multipart/form-data" FormName="formCreatePind" OnValidSubmit="SubmitPindAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <label>Tilføj billede eller video</label>
    <InputFile name="pindDTO.MediaType" class="form-control" required />

    <label>Beskrivelse</label>
    <InputTextArea @bind-Value="pindDTO.Description" class="form-control" />

    <button type="submit">Slå op</button>
</EditForm>




@code {
    
    [SupplyParameterFromForm(FormName = "formCreatePind")]
    private PindDTO? pindDTO { get; set; }

    protected override void OnInitialized() => pindDTO ??= new();

    private async Task SubmitPindAsync()
    {
        await PindService.CreatePindAsync(pindDTO!);
        navigationManager.NavigateTo("/");
    }

 
}
